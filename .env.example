# Kopyalayin: cp .env.example .env   (zorunlu degil; tum degiskenlerin docker-compose.yml'de varsayilani var)

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=avatar
MYSQL_TEST_DATABASE=avatar_test
MYSQL_USER=app
MYSQL_PASSWORD=app

# Host portlari (cakisma olursa degistirin)
MYSQL_HOST_PORT=3306
API_PORT=8080
WEB_PORT=3000
ML_PORT=8000

# API CORS izinli origin'ler (virgulle ayrilmis, "*" hepsi). Uretimde daraltin.
CORS_ORIGINS=*

# Web build aninda gomulen API adresi (tarayicinin gorecegi adres)
VITE_API_URL=http://localhost:8080/api/v1

# `make test-backend` icin (hosttaki MySQL portuna gore)
TEST_DATABASE_URL=app:app@tcp(127.0.0.1:3306)/avatar_test?parseTime=true&loc=UTC&multiStatements=true
